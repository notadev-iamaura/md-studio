{
  "name": "md-studio",
  "version": "1.0.0",
  "description": "로컬 마크다운 편집기 / 뷰어 / 변환기",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test test/convert.test.mjs",
    "build": "node build.mjs",
    "e2e": "node test/e2e.mjs",
    "app": "npm run build && electron .",
    "e2e:app": "npm run build && node test/run-app-e2e.mjs",
    "package:app": "npm run build && electron-builder --mac --publish never && bash mac/adhoc-sign.sh"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@codemirror/commands": "^6.9.0",
    "@codemirror/lang-markdown": "^6.4.0",
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@lezer/highlight": "^1.2.1",
    "dompurify": "^3.2.7",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "esbuild": "^0.25.10",
    "marked": "^16.4.1",
    "playwright": "^1.64.1",
    "turndown": "^7.2.1",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "type": "module",
  "productName": "MD Studio",
  "build": {
    "appId": "local.mdstudio.app",
    "productName": "MD Studio",
    "copyright": "로컬 마크다운 편집기",
    "electronVersion": "44.7.0",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/MD-Studio.html",
      "electron/**",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "mac/AppIcon.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "extendInfo": {
        "CFBundleDevelopmentRegion": "ko"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown 문서",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "publish": null
  },
  "private": true
}
